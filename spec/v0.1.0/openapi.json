  "paths": {
    "/amp/v1/health": {
      "get": {
        "operationId": "health_amp_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Amp V1 Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/amp/v1/lifecycle/run": {
      "post": {
        "description": "Trigger one lifecycle pass immediately — for cron, ops, or tests.\n\nRuns decay, plus the retention purge when `AMP_PURGE_RETENTION` is on. Gated\non `AMP_ADMIN_TOKEN` because it mutates lifecycle state for every cell in\nstorage, and erases data outright when purging is enabled. Unset token ==\ndisabled (403), not an open endpoint.",
        "operationId": "run_lifecycle_now_amp_v1_lifecycle_run_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-amp-admin-token",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Amp-Admin-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Run Lifecycle Now Amp V1 Lifecycle Run Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Access denied; also returned when the cell does not exist"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Lifecycle Now"
      }
    },
